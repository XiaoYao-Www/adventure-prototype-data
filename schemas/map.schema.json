{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-content:schema:map:1",
  "title": "game-content map v1",
  "description": "格子地圖。tiles 列數 = size.height、每列長度 = size.width；字元必須在 legend 中且僅限 # . ~ p t。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "size",
    "tile_size",
    "tiles",
    "legend",
    "spawn",
    "entities",
    "portals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^map_[a-z0-9_]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 4,
          "maximum": 64
        }
      }
    },
    "tile_size": {
      "const": 16
    },
    "tiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 64,
        "pattern": "^[#.~pt]+$"
      }
    },
    "legend": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 5,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tile",
          "walkable"
        ],
        "properties": {
          "tile": {
            "type": "string",
            "enum": [
              "grass",
              "path",
              "wall",
              "water",
              "tree",
              "floor"
            ]
          },
          "walkable": {
            "type": "boolean"
          }
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid"
      ],
      "properties": {
        "grid": {
          "$ref": "#/$defs/grid"
        }
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "portals": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/portal"
      }
    }
  },
  "$defs": {
    "grid": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "grid",
        "display_key",
        "interaction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "npc",
            "object"
          ]
        },
        "grid": {
          "$ref": "#/$defs/grid"
        },
        "display_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "event_id"
          ],
          "properties": {
            "kind": {
              "const": "event"
            },
            "event_id": {
              "type": "string",
              "pattern": "^event_[a-z0-9_]{2,63}$"
            }
          }
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "grid",
        "target_map_id",
        "target_grid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^portal_[a-z0-9_]{2,63}$"
        },
        "grid": {
          "$ref": "#/$defs/grid"
        },
        "target_map_id": {
          "type": "string",
          "pattern": "^map_[a-z0-9_]{2,63}$"
        },
        "target_grid": {
          "$ref": "#/$defs/grid"
        }
      }
    }
  }
}
