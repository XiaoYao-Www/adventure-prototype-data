{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-content:schema:manifest:1",
  "title": "game-content manifest v1",
  "description": "內容包清單。files 只列出資料 JSON，不含 schemas/、docs/ 與 manifest.json 本身；依 path 字典序嚴格遞增排序。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema",
    "content_id",
    "content_version",
    "schema_version",
    "min_game_version",
    "dependencies",
    "files"
  ],
  "properties": {
    "manifest_schema": {
      "const": 1
    },
    "content_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "content_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "schema_version": {
      "const": 1
    },
    "min_game_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_id",
          "content_version"
        ],
        "properties": {
          "content_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "content_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(?!/)(?!.*\\.\\.)[a-z0-9][a-z0-9_./-]*\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
